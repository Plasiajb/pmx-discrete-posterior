$PROBLEM SCN003 OXC posterior-vector PMIX smoke analytic PRED
$INPUT ID TIME DV MDV WT AGE HT
$DATA scn003_oxc_pmix_laplacian.csv IGNORE=@
$PRED
WTLOG=THETA(6)*LOG(WT/THETA(7))
IF (WTLOG.GE.0) THEN
  WTRAT=1/(1+EXP(-WTLOG))
ELSE
  WTNEG=EXP(WTLOG)
  WTRAT=WTNEG/(1+WTNEG)
ENDIF
WTEXP=THETA(4)-THETA(5)*WTRAT
CL=THETA(1)*(WT/70)**WTEXP*EXP(ETA(1))
V=THETA(2)
KA=THETA(3)
DOSE=THETA(8)
TAU=THETA(9)
K=CL/V
C=0
TSS=TIME+TAU
DENK=1-EXP(-K*TAU)
DENKA=1-EXP(-KA*TAU)
C=C+DOSE*KA/(V*(KA-K))*(EXP(-K*TSS)/DENK-EXP(-KA*TSS)/DENKA)
AGE0=TIME-0.0001
D0=0
IF (MIXNUM.EQ.2) D0=1
IF (MIXNUM.EQ.4) D0=1
A0=0
IF (AGE0.GE.0) A0=1
C=C+D0*A0*DOSE*KA/(V*(KA-K))*(EXP(-K*AGE0)-EXP(-KA*AGE0))
AGE12=TIME-12
D12=0
IF (MIXNUM.EQ.3) D12=1
IF (MIXNUM.EQ.4) D12=1
A12=0
IF (AGE12.GE.0) A12=1
C=C+D12*A12*DOSE*KA/(V*(KA-K))*(EXP(-K*AGE12)-EXP(-KA*AGE12))
IPRED=C
POPIND=EPS(1)
F_FLAG=2
Y=LOG(8.952064)+(DV-IPRED)**2/(8.952064)-(2.4937554372832)
$MIX NSPOP=4
P(1)=0.25
P(2)=0.25
P(3)=0.25
P(4)=0.25
$THETA 1.6799999999999999 FIX ;CL_BASE
$THETA 14.699999999999999 FIX ;V
$THETA 0.82999999999999996 FIX ;KA
$THETA 0.624 FIX ;WT_EXP_BASE
$THETA 0.23300000000000001 FIX ;WT_EXP_MAX_DEC
$THETA 219 FIX ;WT_EXP_HILL
$THETA 8.9700000000000006 FIX ;WT_EXP_HALF
$THETA 300 FIX ;DOSE_MG
$THETA 12 FIX ;TAU_H
$OMEGA 0.012245714245884425 FIX ;BSV_CL
$SIGMA 8.952064 FIX ;ADD_VAR
$ESTIMATION PRINT=20 METHOD=1 INTERACTION LAPLACIAN POSTHOC NOABORT MAXEVAL=0 OPTMAP=1 FORMAT=s1PE24.16
$TABLE ID TIME DV MDV WT AGE HT IPRED NOPR ONEHEADER FILE=scn003_oxc_pmix_laplacian.fit FORMAT=s1PE24.16
