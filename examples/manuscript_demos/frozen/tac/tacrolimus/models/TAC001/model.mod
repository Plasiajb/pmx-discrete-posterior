$PROBLEM Tacrolimus independent ADVAN4 reduced-model native MIX posterior
$INPUT ID TIME AMT DV EVID MDV CMT DSEQ OBSIX STATE ECL EV1
$BIND - - - - - - - DOSE - DOSE DOSE DOSE
$DATA data.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
CALLFL=-2
CL=THETA(1)*EXP(ETA(1))
V2=THETA(2)*EXP(ETA(2))
Q=THETA(3)
V3=THETA(4)
KA=THETA(5)
ALAG1=THETA(6)
S2=V2/1000
F1=1
IF (MIXNUM.EQ.1) THEN
 IF (DSEQ.EQ.1) F1=0
 IF (DSEQ.EQ.2) F1=0
ENDIF
IF (MIXNUM.EQ.2) THEN
 IF (DSEQ.EQ.1) F1=1
 IF (DSEQ.EQ.2) F1=0
ENDIF
IF (MIXNUM.EQ.3) THEN
 IF (DSEQ.EQ.1) F1=0
 IF (DSEQ.EQ.2) F1=1
ENDIF
IF (MIXNUM.EQ.4) THEN
 IF (DSEQ.EQ.1) F1=1
 IF (DSEQ.EQ.2) F1=1
ENDIF
$ERROR
CP=F
Y=F*(1+EPS(1))+EPS(2)
$THETA
25.5 FIX ; cl
113 FIX ; v1
67.900000000000006 FIX ; q
1060 FIX ; v2
0.34999999999999998 FIX ; ka
0.44 FIX ; lag
$OMEGA BLOCK(2) FIX
0.083444606954634404
0 0.19805053857439608
$SIGMA 0.033488999999999998 FIX
$SIGMA 0.0025000000000000005 FIX
$MIX
NSPOP=4
P(1)=0.25
P(2)=0.25
P(3)=0.25
P(4)=0.25
$ESTIMATION METHOD=1 INTERACTION LAPLACIAN POSTHOC MAXEVAL=0 NOABORT FORMAT=s1PE24.16
$TABLE ID TIME EVID MDV CMT DSEQ OBSIX STATE ECL EV1 CP
NOPRINT ONEHEADER NOAPPEND FILE=predictions.tab FORMAT=s1PE24.16
